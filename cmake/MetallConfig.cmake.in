@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Installed C++ consumers need these dependencies resolved before the imported
# Metall target can expose its transitive usage requirements.
find_dependency(Threads REQUIRED)
find_dependency(Boost 1.80 REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

if (TARGET @PROJECT_NAME@::@PROJECT_NAME@)
	# Boost target names differ across Boost/CMake combinations. Normalize the
	# imported interface to whichever representation the local toolchain exposes.
	if (TARGET Boost::headers)
		set_property(TARGET @PROJECT_NAME@::@PROJECT_NAME@ APPEND PROPERTY
				INTERFACE_LINK_LIBRARIES Boost::headers)
	elseif (TARGET Boost::boost)
		set_property(TARGET @PROJECT_NAME@::@PROJECT_NAME@ APPEND PROPERTY
				INTERFACE_LINK_LIBRARIES Boost::boost)
	elseif (DEFINED Boost_INCLUDE_DIRS AND Boost_INCLUDE_DIRS)
		set_property(TARGET @PROJECT_NAME@::@PROJECT_NAME@ APPEND PROPERTY
				INTERFACE_INCLUDE_DIRECTORIES "${Boost_INCLUDE_DIRS}")
	endif ()
endif ()